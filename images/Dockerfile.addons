# claude_here add-on layer: optional Node.js (+ latest npm/npx) and uv/uvx.
# Built between the variant and the user layers when node/uv are enabled.
ARG BASE
FROM ${BASE}
ARG CH_USER=ni
ARG ADD_NODE=0
ARG ADD_UV=0
ARG NODE_MAJOR=22

RUN if [ "${ADD_NODE}" = "1" ]; then \
      curl -fsSL "https://deb.nodesource.com/setup_${NODE_MAJOR}.x" | bash - \
   && apt-get install -y --no-install-recommends nodejs \
   && rm -rf /var/lib/apt/lists/* \
   && npm install -g npm@latest \
   && node --version && npm --version && npx --version; \
    fi

RUN if [ "${ADD_UV}" = "1" ]; then \
      curl -LsSf https://astral.sh/uv/install.sh | UV_INSTALL_DIR=/usr/local/bin UV_NO_MODIFY_PATH=1 sh \
   && uv --version && uvx --version; \
    fi

USER root
ENTRYPOINT ["/usr/local/lib/claude_here/entrypoint.sh"]
