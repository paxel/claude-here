# claude_here base image: Debian slim + Claude Code (native installer) +
# common tooling + tcpdump/tshark for per-session network capture.
FROM debian:trixie-slim

ARG CH_USER=ni
ARG CH_UID=1000
ARG CH_GID=1000
ARG CLAUDE_VERSION=latest
ARG TERMSHARK_VERSION=2.4.0

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8 \
    DISABLE_AUTOUPDATER=1

RUN echo 'wireshark-common wireshark-common/install-setuid boolean false' | debconf-set-selections \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      bash ca-certificates curl git gh gnupg less locales nano procps \
      ripgrep fd-find jq unzip zip graphviz \
      python3 python3-pip python3-venv \
      build-essential pkg-config libssl-dev \
      openssh-client \
      tcpdump tshark util-linux \
 && rm -rf /var/lib/apt/lists/* \
 && ln -s /usr/bin/fdfind /usr/local/bin/fd \
 && sed -i 's/^# *en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen \
 && locale-gen

# termshark for `claude_here net shark`
RUN arch="$(dpkg --print-architecture)"; \
    case "$arch" in amd64) ts=x64 ;; arm64) ts=arm64 ;; *) echo "unsupported arch $arch"; exit 1 ;; esac; \
    curl -fsSL "https://github.com/gcla/termshark/releases/download/v${TERMSHARK_VERSION}/termshark_${TERMSHARK_VERSION}_linux_${ts}.tar.gz" \
      | tar -xz -C /usr/local/bin --strip-components=1 --wildcards '*/termshark'

# Unprivileged user matching the host uid/gid, plus a separate user that owns
# the packet capture so the sandbox user cannot tamper with it.
RUN (getent group "${CH_GID}" >/dev/null || groupadd -g "${CH_GID}" "${CH_USER}") \
 && useradd -m -u "${CH_UID}" -g "${CH_GID}" -s /bin/bash "${CH_USER}" \
 && useradd -r -M -s /usr/sbin/nologin netlog \
 && mkdir -p "/home/${CH_USER}/.claude" "/home/${CH_USER}/.local/bin" \
 && chown -R "${CH_UID}:${CH_GID}" "/home/${CH_USER}"

# Claude Code native binary, installed into the sandbox user's home.
USER ${CH_USER}
RUN curl -fsSL https://claude.ai/install.sh | bash -s -- "${CLAUDE_VERSION}" \
 && "/home/${CH_USER}/.local/bin/claude" --version
USER root

ENV PATH="/home/${CH_USER}/.local/bin:${PATH}"

COPY entrypoint.sh net-summary.sh /usr/local/lib/claude_here/
COPY git-shim.sh /usr/local/bin/git
RUN chmod 755 /usr/local/lib/claude_here/*.sh /usr/local/bin/git

LABEL claude_here.user="${CH_USER}" \
      claude_here.uid="${CH_UID}" \
      claude_here.gid="${CH_GID}"

ENTRYPOINT ["/usr/local/lib/claude_here/entrypoint.sh"]
