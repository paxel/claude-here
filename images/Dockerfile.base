# claude_here base image: Debian slim + Claude Code (native installer) +
# common tooling + tcpdump/tshark for per-session network capture.
FROM debian:trixie-slim

ARG CH_USER=ni
ARG CH_UID=1000
ARG CH_GID=1000
ARG CLAUDE_VERSION=latest
ARG TERMSHARK_VERSION=2.4.0

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8 \
    DISABLE_AUTOUPDATER=1

# Transient network failures must not throw away a long image build.
RUN printf 'Acquire::Retries "5";\nAcquire::http::Timeout "30";\n' \
      > /etc/apt/apt.conf.d/80-claude-here-retries

RUN echo 'wireshark-common wireshark-common/install-setuid boolean false' | debconf-set-selections \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      bash ca-certificates curl git gh gnupg less locales nano procps \
      ripgrep fd-find jq unzip zip graphviz \
      python3 python3-pip python3-venv \
      build-essential pkg-config libssl-dev \
      openssh-client \
      tcpdump tshark util-linux \
      dnsmasq ipset iptables \
 && rm -rf /var/lib/apt/lists/* \
 && ln -s /usr/bin/fdfind /usr/local/bin/fd \
 && sed -i 's/^# *en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen \
 && locale-gen

# termshark for `claude_here net shark`
RUN arch="$(dpkg --print-architecture)"; \
    case "$arch" in amd64) ts=x64 ;; arm64) ts=arm64 ;; *) echo "unsupported arch $arch"; exit 1 ;; esac; \
    curl -fsSL --retry 5 --retry-delay 3 --retry-all-errors --connect-timeout 20 -o /tmp/termshark.tar.gz \
      "https://github.com/gcla/termshark/releases/download/v${TERMSHARK_VERSION}/termshark_${TERMSHARK_VERSION}_linux_${ts}.tar.gz" \
 && tar -xzf /tmp/termshark.tar.gz -C /usr/local/bin --strip-components=1 --wildcards '*/termshark' \
 && rm /tmp/termshark.tar.gz

# Unprivileged user matching the host uid/gid, plus a separate user that owns
# the packet capture so the sandbox user cannot tamper with it.
RUN (getent group "${CH_GID}" >/dev/null || groupadd -g "${CH_GID}" "${CH_USER}") \
 && useradd -m -u "${CH_UID}" -g "${CH_GID}" -s /bin/bash "${CH_USER}" \
 && useradd -r -M -s /usr/sbin/nologin netlog \
 && mkdir -p "/home/${CH_USER}/.claude" "/home/${CH_USER}/.local/bin" \
 && chown -R "${CH_UID}:${CH_GID}" "/home/${CH_USER}"

# Claude Code native binary, installed into the sandbox user's home.
USER ${CH_USER}
RUN curl -fsSL --retry 5 --retry-delay 3 --retry-all-errors --connect-timeout 20 https://claude.ai/install.sh | bash -s -- "${CLAUDE_VERSION}" \
 && "/home/${CH_USER}/.local/bin/claude" --version
USER root

ENV PATH="/usr/local/lib/claude_here/shims:/home/${CH_USER}/.local/bin:${PATH}"

COPY entrypoint.sh net-summary.sh cloud-shim.sh net-allowlist.sh /usr/local/lib/claude_here/
COPY git-shim.sh /usr/local/bin/git
RUN chmod 755 /usr/local/lib/claude_here/*.sh /usr/local/bin/git

# Cloud shims live in a directory that comes first on PATH, so they are found
# before the real binaries a cloud toolchain installs into /usr/local/bin.
# dnsmasq is only started by the entrypoint in net mode allowlist.
RUN printf 'conf-dir=/etc/dnsmasq.d/,*.conf\n' > /etc/dnsmasq.conf \
 && mkdir -p /etc/dnsmasq.d

RUN mkdir -p /usr/local/lib/claude_here/shims \
 && for t in kubectl helm terraform aws gcloud az; do \
      ln -s /usr/local/lib/claude_here/cloud-shim.sh "/usr/local/lib/claude_here/shims/$t"; \
    done

LABEL claude_here.user="${CH_USER}" \
      claude_here.uid="${CH_UID}" \
      claude_here.gid="${CH_GID}"

ENTRYPOINT ["/usr/local/lib/claude_here/entrypoint.sh"]
